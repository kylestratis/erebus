# Erebus Environment Variables
# =============================
#
# This file contains SECRETS and environment-specific overrides.
# For non-sensitive configuration, use config.toml (copy from config.example.toml).
#
# Environment variables OVERRIDE values from config.toml.

# ===========================================================================
# REQUIRED - These must be set for Erebus to function
# ===========================================================================

# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here  # Numeric ID

# AI Model Provider Keys (passed to Letta server via docker-compose)
ANTHROPIC_API_KEY=sk-ant-...    # Required: Used by Letta for Claude
OPENAI_API_KEY=sk-...           # Required: Used by Letta for embeddings

# ===========================================================================
# OPTIONAL - Integrations (enable as needed)
# ===========================================================================

# Todoist Integration
TODOIST_API_TOKEN=your_todoist_api_token_here

# GitHub Integration (future)
# GITHUB_TOKEN=your_github_personal_access_token_here

# Readwise Integration (future)
# READWISE_API_KEY=your_readwise_api_key_here

# ===========================================================================
# OPTIONAL - Path Overrides
# ===========================================================================

# Obsidian Vault Path (can also be set in config.toml)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# ===========================================================================
# OPTIONAL - Environment Overrides
# ===========================================================================
# These override config.toml values for environment-specific settings

# DISCORD_GUILD_ID=123456789012345678  # For faster dev slash command sync
# LETTA_API_URL=http://localhost:8283
# LETTA_API_KEY=optional_letta_api_key
# LOG_LEVEL=DEBUG
# ENVIRONMENT=development
# SCHEDULER_TIMEZONE=America/Chicago

# ===========================================================================
# OPTIONAL - Additional User Allowlist
# ===========================================================================
# Comma-separated list of additional Discord user IDs allowed to use the bot
# (Primary user from DISCORD_USER_ID is always allowed)

# ALLOWED_USER_IDS=123456789,987654321
