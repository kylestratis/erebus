# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here  # Numeric ID
DISCORD_GUILD_ID=optional_test_server_id

# AI Model Provider
CLAUDE_API_KEY=your_anthropic_api_key_here

# Productivity Integrations
TODOIST_API_TOKEN=your_todoist_api_token_here
GITHUB_TOKEN=your_github_personal_access_token_here
READWISE_API_KEY=your_readwise_api_key_here

# MCP Servers
OBSIDIAN_MCP_URL=http://localhost:8000  # or remote URL
OBSIDIAN_MCP_TOKEN=your_obsidian_mcp_auth_token_here

# Letta Configuration
LETTA_API_URL=http://localhost:8283
LETTA_API_KEY=optional_letta_api_key

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development  # development, staging, production

# Autonomous Tasks
DOWNTIME_ENABLED=false
DOWNTIME_SCHEDULE=0 2 * * *  # Cron: 2am daily
DOWNTIME_TOKEN_BUDGET=1000

# Security
ENABLE_SANITIZER_AGENT=true
ALLOWED_USER_IDS=your_discord_user_id_here  # Comma-separated list
