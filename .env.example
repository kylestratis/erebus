# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here  # Numeric ID
DISCORD_GUILD_ID=optional_test_server_id

# AI Model Provider Keys (passed to Letta server via docker-compose)
ANTHROPIC_API_KEY=sk-ant-...    # Required: Used by Letta for Claude
OPENAI_API_KEY=sk-...           # Required: Used by Letta for embeddings

# Productivity Integrations
TODOIST_API_TOKEN=your_todoist_api_token_here
GITHUB_TOKEN=your_github_personal_access_token_here
READWISE_API_KEY=your_readwise_api_key_here

# Obsidian Vault (direct integration)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_TEMPLATES_PATH=Templates                    # Optional, default: Templates
OBSIDIAN_DAILY_NOTES_PATH=Calendar/Daily Notes       # Optional, default: Calendar/Daily Notes
OBSIDIAN_DAILY_NOTE_FORMAT=%Y-%m-%d                  # Optional, default: %Y-%m-%d

# Letta Configuration
LETTA_API_URL=http://localhost:8283
LETTA_API_KEY=optional_letta_api_key

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development  # development, staging, production

# Scheduler Configuration
SCHEDULER_ENABLED=true                          # Enable/disable all scheduled jobs
SCHEDULER_TIMEZONE=America/Chicago              # IANA timezone for job schedules, default is America/New_York

# Daily Note Job (6am by default)
JOB_DAILY_NOTE_ENABLED=true
JOB_DAILY_NOTE_CRON=0 6 * * *                   # Cron: minute hour day month day_of_week

# End-of-Day Sync Job (11:55pm by default)
JOB_END_OF_DAY_SYNC_ENABLED=true
JOB_END_OF_DAY_SYNC_CRON=55 23 * * *

# Weekly Review Job (Sunday 6pm by default)
JOB_WEEKLY_REVIEW_ENABLED=true
JOB_WEEKLY_REVIEW_CRON=0 18 * * 0               # 0 = Sunday

# Autonomous Tasks (future)
DOWNTIME_ENABLED=false
DOWNTIME_SCHEDULE=0 2 * * *  # Cron: 2am daily
DOWNTIME_TOKEN_BUDGET=1000

# Security
ENABLE_SANITIZER_AGENT=true
ALLOWED_USER_IDS=your_discord_user_id_here  # Comma-separated list
